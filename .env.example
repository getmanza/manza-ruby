# Copy to .env (gitignored). Required to record cassettes against staging.
#
#   bundle exec rake fixtures:record
#
# Cassettes are scrubbed before write — the real key never lands in git.

ZAZU_STAGING_URL=https://staging.zazu.ma
ZAZU_STAGING_API_KEY=

# Machine-authorization cassettes (see the one-time setup at the top of
# lib/tasks/fixtures.rake). A second key with `transfers:authorize`, the
# signing secret of the webhook endpoint enrolled as transfer authorizer,
# and the local port its tunnel forwards to. If the key is rotated or the
# endpoint re-enrolled, update these or `fixtures:record` breaks.
ZAZU_STAGING_AUTHORIZER_API_KEY=
ZAZU_STAGING_AUTHORIZER_SECRET=
ZAZU_STAGING_AUTHORIZER_PORT=4599

# Stable resource IDs to use during recording. Either pre-create these
# in your staging entity, or let the create-cassettes rake task seed
# them (TODO: write seed task).

ZAZU_FIXTURE_ACCOUNT_ID=
ZAZU_FIXTURE_TRANSACTION_ID=
ZAZU_FIXTURE_CUSTOMER_ID=
ZAZU_FIXTURE_DELETABLE_CUSTOMER_ID=
ZAZU_FIXTURE_INVOICE_ID=
ZAZU_FIXTURE_SENDABLE_INVOICE_ID=
ZAZU_FIXTURE_PAYABLE_INVOICE_ID=
ZAZU_FIXTURE_CANCELLABLE_INVOICE_ID=
ZAZU_FIXTURE_CREDITABLE_INVOICE_ID=
ZAZU_FIXTURE_DELETABLE_INVOICE_ID=
ZAZU_FIXTURE_PAYMENT_LINK_ID=
ZAZU_FIXTURE_CANCELLABLE_PAYMENT_LINK_ID=
ZAZU_FIXTURE_WEBHOOK_ID=
ZAZU_FIXTURE_ENABLED_WEBHOOK_ID=
ZAZU_FIXTURE_DISABLED_WEBHOOK_ID=
ZAZU_FIXTURE_DELETABLE_WEBHOOK_ID=
ZAZU_FIXTURE_CHECKOUT_SESSION_ID=
# Written by `rake fixtures:seed`:
ZAZU_FIXTURE_BENEFICIARY_ID=
ZAZU_FIXTURE_TRANSFER_DRAFT_ID=
ZAZU_FIXTURE_TRUSTED_EXTERNAL_ACCOUNT_ID=
ZAZU_FIXTURE_CREATED_BENEFICIARY_ID=
ZAZU_FIXTURE_EXTERNAL_ACCOUNT_ID=
ZAZU_FIXTURE_NEW_ACCOUNT_NUMBER=
ZAZU_FIXTURE_PAYEE_TRUST_REQUEST_ID=
ZAZU_FIXTURE_CLIENT_REFERENCE=
ZAZU_FIXTURE_AUTHORIZABLE_CLIENT_REFERENCE=
ZAZU_FIXTURE_AUTHORIZABLE_DRAFT_ID=
ZAZU_FIXTURE_DECLINABLE_DRAFT_ID=
ZAZU_FIXTURE_BAD_SIGNATURE_DRAFT_ID=
ZAZU_FIXTURE_AUTHORIZABLE_AUTHORIZATION_ID=
ZAZU_FIXTURE_DECLINABLE_AUTHORIZATION_ID=
ZAZU_FIXTURE_BAD_SIGNATURE_AUTHORIZATION_ID=
ZAZU_FIXTURE_AUTHORIZABLE_NONCE=
