# Copy to .env (gitignored). Required to record cassettes against staging.
#
#   bundle exec rake fixtures:record
#
# Cassettes are scrubbed before write — the real key never lands in git.

MANZA_STAGING_URL=https://ma.manza.dev
MANZA_STAGING_API_KEY=

# Machine-authorization cassettes (see the one-time setup at the top of
# lib/tasks/fixtures.rake). A second key with `transfers:authorize`, the
# signing secret of the webhook endpoint enrolled as transfer authorizer,
# and the local port its tunnel forwards to. If the key is rotated or the
# endpoint re-enrolled, update these or `fixtures:record` breaks.
MANZA_STAGING_AUTHORIZER_API_KEY=
MANZA_STAGING_AUTHORIZER_SECRET=
MANZA_STAGING_AUTHORIZER_PORT=4599

# Stable resource IDs to use during recording. Either pre-create these
# in your staging entity, or let the create-cassettes rake task seed
# them (TODO: write seed task).

MANZA_FIXTURE_ACCOUNT_ID=
MANZA_FIXTURE_TRANSACTION_ID=
MANZA_FIXTURE_CUSTOMER_ID=
MANZA_FIXTURE_DELETABLE_CUSTOMER_ID=
MANZA_FIXTURE_INVOICE_ID=
MANZA_FIXTURE_SENDABLE_INVOICE_ID=
MANZA_FIXTURE_PAYABLE_INVOICE_ID=
MANZA_FIXTURE_CANCELLABLE_INVOICE_ID=
MANZA_FIXTURE_CREDITABLE_INVOICE_ID=
MANZA_FIXTURE_DELETABLE_INVOICE_ID=
MANZA_FIXTURE_PAYMENT_LINK_ID=
MANZA_FIXTURE_CANCELLABLE_PAYMENT_LINK_ID=
MANZA_FIXTURE_WEBHOOK_ID=
MANZA_FIXTURE_ENABLED_WEBHOOK_ID=
MANZA_FIXTURE_DISABLED_WEBHOOK_ID=
MANZA_FIXTURE_DELETABLE_WEBHOOK_ID=
MANZA_FIXTURE_CHECKOUT_SESSION_ID=
# Hand-provided: the beneficiary whose default bank account is a trusted
# payee (one-time setup step 5 in lib/tasks/fixtures.rake).
MANZA_FIXTURE_BENEFICIARY_ID=
# Written by `rake fixtures:seed`:
MANZA_FIXTURE_TRANSFER_DRAFT_ID=
MANZA_FIXTURE_TRUSTED_EXTERNAL_ACCOUNT_ID=
MANZA_FIXTURE_CREATED_BENEFICIARY_ID=
MANZA_FIXTURE_EXTERNAL_ACCOUNT_ID=
MANZA_FIXTURE_NEW_ACCOUNT_NUMBER=
MANZA_FIXTURE_PAYEE_TRUST_REQUEST_ID=
MANZA_FIXTURE_CLIENT_REFERENCE=
MANZA_FIXTURE_AUTHORIZABLE_CLIENT_REFERENCE=
MANZA_FIXTURE_AUTHORIZABLE_DRAFT_ID=
MANZA_FIXTURE_DECLINABLE_DRAFT_ID=
MANZA_FIXTURE_BAD_SIGNATURE_DRAFT_ID=
MANZA_FIXTURE_AUTHORIZABLE_AUTHORIZATION_ID=
MANZA_FIXTURE_DECLINABLE_AUTHORIZATION_ID=
MANZA_FIXTURE_BAD_SIGNATURE_AUTHORIZATION_ID=
MANZA_FIXTURE_AUTHORIZABLE_NONCE=
