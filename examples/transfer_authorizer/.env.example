# Copy to .env and fill in. Never commit .env.

# https://ma.manza.finance (Morocco), https://za.manza.finance (South Africa),
# or https://ma.manza.dev for staging.
MANZA_BASE_URL=https://ma.manza.finance

# Key A: creates transfer drafts (scope transfers:write).
MANZA_CREATOR_API_KEY=
# Key B: answers the challenges (scope transfers:authorize). Must differ from key A.
MANZA_AUTHORIZER_API_KEY=
# Signing secret of the webhook endpoint enrolled as transfer authorizer.
MANZA_AUTHORIZER_SECRET=

# The account to pay from and a beneficiary whose bank account is a trusted payee.
MANZA_ACCOUNT_ID=
MANZA_BENEFICIARY_ID=

# The local port your tunnel forwards to: bundle exec rackup -p 4599 (rackup reads -p, not this file).
PORT=4599
